  </rdfs:domain>
  <rdfs:range>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#atiende"/>
      <owl:someValuesFrom rdf:resource="#Cita"/>
    </owl:Restriction>
  </rdfs:range>
</owl:ObjectProperty>

